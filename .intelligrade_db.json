  "examinations": [
    {
      "id": "EXAM-CAT1-DEV",
      "name": "Continuous Assessment Test 1 (CAT 1) — DEV",
      "type": "CAT 1",
      "subject": "Data Exploration and Visualization",
      "department": "AI & Data Science",
      "semester": "Sem 5",
      "academicYear": "2026-2027",
      "date": "2026-09-15",
      "startTime": "09:30",
      "endTime": "11:00",
      "maxMarks": 50,
      "passingMarks": 25,
      "instructions": "Answer all descriptive questions. Show mathematical steps for IQR and box plot boundary calculations.",
      "syllabusVersionId": "SYL-DEV-001",
      "createdAt": "2026-08-20T09:00:00Z",
      "createdBy": "USR-TEACHER-001",
      "questions": [
        {
          "id": "Q-DEV-1",
          "questionNumber": "1",
          "questionText": "Explain the mathematical construction of a Box and Whisker Plot. Discuss how it identifies potential outliers using the Interquartile Range (IQR) rule.",
          "maxMarks": 20,
          "unitNumber": 1,
          "topicId": "TOP-DEV-01",
          "modelAnswer": "A Box Plot displays the five-number summary: Min, Q1, Median, Q3, and Max. The central box represents IQR = Q3 - Q1. Outliers are points beyond Q1 - 1.5*IQR or Q3 + 1.5*IQR.",
          "rubricCriteria": [
            {
              "criterionName": "Five-Number Summary Definition",
              "maxMarks": 5,
              "description": "Correctly identifies Min, Q1, Median, Q3, Max"
            },
            {
              "criterionName": "IQR Formula & Meaning",
              "maxMarks": 5,
              "description": "States IQR = Q3 - Q1 and middle 50% spread"
            },
            {
              "criterionName": "Tukey Outlier Fences",
              "maxMarks": 7,
              "description": "Defines Lower Fence (Q1 - 1.5*IQR) and Upper Fence (Q3 + 1.5*IQR)"
            },
            {
              "criterionName": "Clarity and Structure",
              "maxMarks": 3,
              "description": "Logically organized with diagrams/steps"
            }
          ]
        },
        {
          "id": "Q-DEV-2",
          "questionNumber": "2",
          "questionText": "Compare Pearson Correlation Coefficient with Spearman Rank Correlation in bivariate data exploration.",
          "maxMarks": 30,
          "unitNumber": 3,
          "topicId": "TOP-DEV-03",
          "modelAnswer": "Pearson measures linear relationships for continuous variables. Spearman measures monotonic relationships based on ranked orders.",
          "rubricCriteria": [
            {
              "criterionName": "Pearson Linearity",
              "maxMarks": 10,
              "description": "Linear relationship and parametric assumptions"
            },
            {
              "criterionName": "Spearman Monotonicity",
              "maxMarks": 10,
              "description": "Rank-based monotonic relationship and robustness to outliers"
            },
            {
              "criterionName": "Mathematical Formulations",
              "maxMarks": 10,
              "description": "Accurate formulas and range [-1.0 to +1.0]"
            }
          ]
        }
      ]
    },
    {
      "id": "EXAM-CAT2-DBMS",
      "name": "Continuous Assessment Test 2 (CAT 2) — DBMS",
      "type": "CAT 2",
      "subject": "Database Management Systems",
      "department": "Computer Science & Engineering",
      "semester": "Sem 5",
      "academicYear": "2026-2027",
      "date": "2026-10-22",
      "startTime": "13:30",
      "endTime": "15:00",
      "maxMarks": 50,
      "passingMarks": 25,
      "instructions": "Explain transaction schedules with rollback traces.",
      "syllabusVersionId": "SYL-DBMS-001",
      "createdAt": "2026-09-10T09:00:00Z",
      "createdBy": "USR-TEACHER-001",
      "questions": [
        {
          "id": "Q-DBMS-1",
          "questionNumber": "1",
          "questionText": "Explain the ACID properties in transaction processing and describe how write-ahead logging (WAL) guarantees the Durability and Atomicity properties.",
          "maxMarks": 25,
          "unitNumber": 1,
          "topicId": "TOP-DBMS-01",
          "modelAnswer": "Atomicity (all or nothing), Consistency, Isolation, Durability. WAL writes log records to disk before data pages to allow undo and redo on crash.",
          "rubricCriteria": [
            {
              "criterionName": "ACID Properties Definition",
              "maxMarks": 10,
              "description": "Full and accurate definition of A, C, I, D"
            },
            {
              "criterionName": "Write-Ahead Logging Mechanics",
              "maxMarks": 10,
              "description": "Explains undo/redo logs before flushing dirty pages"
            },
            {
              "criterionName": "Crash Recovery Execution",
              "maxMarks": 5,
              "description": "Details rollforward for durability and rollback for atomicity"
            }
          ]
        }
      ]
    }
  ],
  "syllabusDocuments": [
    {
      "id": "SYL-DEV-001",
      "subject": "Data Exploration and Visualization",
      "semester": "Sem 5",
      "academicYear": "2026-2027",
      "version": 1,
      "uploadedAt": "2026-08-01T10:00:00Z",
      "uploadedBy": "USR-TEACHER-001",
      "status": "active",
      "topics": [
        {
          "id": "TOP-DEV-01",
          "unitNumber": 1,
          "unitTitle": "Exploratory Data Analysis Foundations",
          "topicTitle": "Descriptive Statistics & Five-Number Summary",
          "description": "Calculation of mean, median, mode, IQR, standard deviation and Tukey outlier detection.",
          "learningOutcomes": [
            "Understand parametric vs non-parametric metrics",
            "Compute Quartiles and IQR",
            "Identify anomalies using Tukey fences"
          ],
          "importanceWeight": 5,
          "estimatedHours": 4.5
        },
        {
          "id": "TOP-DEV-02",
          "unitNumber": 2,
          "unitTitle": "Data Quality & Preprocessing",
          "topicTitle": "Missing Value Handling & Normalization",
          "description": "Techniques for mean/median imputation, row omission, and min-max feature scaling.",
          "learningOutcomes": [
            "Identify missingness mechanisms",
            "Perform median imputation"
          ],
          "importanceWeight": 4,
          "estimatedHours": 3.5
        },
        {
          "id": "TOP-DEV-03",
          "unitNumber": 3,
          "unitTitle": "Multivariate Visualization",
          "topicTitle": "Correlation Matrices & Scatter Regression",
          "description": "Pearson correlation coefficient derivation, heatmaps, and linear regression trendlines.",
          "learningOutcomes": [
            "Interpret correlation matrix -1.0 to +1.0",
            "Plot bivariate scatter with R-squared"
          ],
          "importanceWeight": 5,
          "estimatedHours": 5
        }
      ]
    },
    {
      "id": "SYL-DBMS-001",
      "subject": "Database Management Systems",
      "semester": "Sem 5",
      "academicYear": "2026-2027",
      "version": 1,
      "uploadedAt": "2026-08-01T10:00:00Z",
      "uploadedBy": "USR-TEACHER-001",
      "status": "active",
      "topics": [
        {
          "id": "TOP-DBMS-01",
          "unitNumber": 1,
          "unitTitle": "Transaction Management",
          "topicTitle": "ACID Properties and Concurrency Control",
          "description": "Atomicity, Consistency, Isolation, Durability guarantees and two-phase locking.",
          "learningOutcomes": [
            "Explain ACID guarantees",
            "Contrast serializability with dirty reads"
          ],
          "importanceWeight": 5,
          "estimatedHours": 4
        },
        {
          "id": "TOP-DBMS-02",
          "unitNumber": 2,
          "unitTitle": "Database Recovery",
          "topicTitle": "Write-Ahead Logging (WAL) & ARIES Protocol",
          "description": "Redo and Undo logging mechanisms ensuring crash recovery.",
          "learningOutcomes": [
            "Describe WAL principles",
            "Explain rollback and rollforward recovery phases"
          ],
          "importanceWeight": 5,
          "estimatedHours": 4.5
        }
      ]
    }
